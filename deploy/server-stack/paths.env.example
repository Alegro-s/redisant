WAYPOINT_ROOT="${WAYPOINT_ROOT:-$HOME/Waypoint}"
LYNX_ROOT="${LYNX_ROOT:-$HOME/Lynx}"
TSPUT_ROOT="${TSPUT_ROOT:-$HOME/tsput_profile}"

