# YALGSI / AVITO hackathon messenger — VPS env
# Copy: sudo cp deploy/ecosystem/avito.env.example /opt/waypoint/avito.env && sudo nano /opt/waypoint/avito.env

POSTGRES_USER=aishield
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=aishield

API_PORT=8000
MATTERMOST_PORT=8065
MM_DB_PASSWORD=CHANGE_MM_DB_PASSWORD

# Публичный URL API (для клиентов и CORS)
PUBLIC_HOST=https://waypointclub.ru/yalgsi
MATTERMOST_SITEURL=http://127.0.0.1:8065
CORS_ORIGINS=https://waypointclub.ru,https://lynx-hub.ru

ADMIN_API_KEY=GENERATE_LONG_RANDOM
SECURE_CONFIG_SEED=GENERATE_LONG_RANDOM

DEBUG=false

# Опционально: Telegram, LM Studio, FCM — см. avito-messenger/.env.example
TELEGRAM_ALERTS_ENABLED=false
MATTERMOST_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
