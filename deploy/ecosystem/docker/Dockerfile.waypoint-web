FROM node:20-bookworm-slim AS build

WORKDIR /app

ARG SITE_MODE=club

ARG VITE_CLUB_URL=https://waypointclub.ru

ARG VITE_METRIC_URL=https://metrika-waypoint.ru

ARG VITE_DESKTOP_URL=https://metrika-waypoint.ru/desktop

ARG VITE_LYNX_HUB_URL=https://lynx-hub.ru

ARG VITE_LYNX_CLOUD_URL=https://lynx-cloud.ru

ARG VITE_ROZA_URL=https://waypointclub.ru/roza
ARG VITE_WAYPOINT_DESKTOP_URL=https://s3.twcstorage.ru/bc39a46d-ee3d-4707-9e3f-9529afb602da/project's/waypointdesktop/WaypointDesktop-setup.msi

COPY Waypoint/web/package.json Waypoint/web/package-lock.json* ./

RUN npm ci

COPY Waypoint/web/ .

ENV VITE_API_URL=/api

ENV VITE_AUTH_URL=/auth

ENV VITE_PUBLIC_SITE_MODE=${SITE_MODE}

ENV VITE_CLUB_URL=${VITE_CLUB_URL}

ENV VITE_METRIC_URL=${VITE_METRIC_URL}

ENV VITE_DESKTOP_URL=${VITE_DESKTOP_URL}

ENV VITE_LYNX_HUB_URL=${VITE_LYNX_HUB_URL}

ENV VITE_LYNX_CLOUD_URL=${VITE_LYNX_CLOUD_URL}

ENV VITE_ROZA_URL=${VITE_ROZA_URL}
ENV VITE_WAYPOINT_DESKTOP_URL=${VITE_WAYPOINT_DESKTOP_URL}

RUN npm run build



FROM nginx:1.27-alpine

COPY deploy/ecosystem/docker/nginx-spa.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

