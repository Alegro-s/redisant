FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY Lynx/hub/package.json Lynx/hub/package-lock.json* ./
RUN npm ci
COPY Lynx/hub/ .
ENV VITE_LYNX_CLOUD_URL=http://127.0.0.1:3001
ENV VITE_WAYPOINT_METRIC_URL=http://127.0.0.1:3002
ENV VITE_WAYPOINT_CLUB_URL=http://127.0.0.1:3000
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/ecosystem/docker/nginx-lynx-hub.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
