# Скопируйте в: d:\PO\deploy\ecosystem\smtp.env
# На VPS: /opt/waypoint/smtp.env

# Пароль БД: только буквы и цифры (без @ : / $ # пробелов), иначе auth-api: "invalid port number"
POSTGRES_PASSWORD=WaypointProdChangeMe2026xK9
# Либо задайте полный URL (пароль в URL-кодировке, %40 = @):
# DATABASE_URL=postgres://waypoint:YourEncodedPass@db:5432/waypoint
JWT_SECRET=минимум-32-случайных-символа-для-jwt-секрета

# ========== Яндекс.Почта (сервер / продакшен) ==========
# Пароль: https://id.yandex.ru → Безопасность → Пароли приложений → «Почта»
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=igor-vinogradov04@yandex.ru
SMTP_PASSWORD=пароль-приложения-яндекс
SMTP_FROM=Waypoint <igor-vinogradov04@yandex.ru>
SMTP_TLS=1

# ========== Локальный тест БЕЗ Яндекса (MailHog на Windows) ==========
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USER=dev
# SMTP_PASSWORD=dev
# SMTP_FROM=dev@localhost
# SMTP_TLS=0

OTP_WEBHOOK_URL=http://email-relay:8025/send
OTP_WEBHOOK_SECRET=любая-длинная-секретная-строка
OTP_LOG_CODES=0

PUBLIC_WEB_BASE_URL=https://waypointclub.ru
CORS_ALLOWED_ORIGINS=https://waypointclub.ru,https://metrika-waypoint.ru,https://lynx-hub.ru,https://lynx-cloud.ru

# ========== Roza AI (чат на waypointclub.ru/roza) ==========
# По умолчанию в Docker: Ollama (контейнер roza-ollama, модель qwen2.5:3b).
# ROZA_LLM_BACKEND=ollama
# ROZA_OLLAMA_URL=http://ollama:11434
# ROZA_MODEL=qwen2.5:3b
# Вместо Ollama — OpenAI-совместимый API:
# ROZA_LLM_BACKEND=openai_compatible
# ROZA_OPENAI_BASE_URL=https://api.openai.com/v1
# ROZA_OPENAI_API_KEY=sk-...
# ROZA_OPENAI_MODEL=gpt-4o-mini
