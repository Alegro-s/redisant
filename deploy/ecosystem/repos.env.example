# /opt/waypoint/repos.env — source перед deploy

GITHUB_USER=your-github-login
GITHUB_TOKEN=ghp_xxxxxxxx

# Имена репозиториев на GitHub (без org prefix)
REPO_AUTH=waypoint-auth
REPO_APIS=waypoint-apis
REPO_CLUB_WEB=waypoint-club-web
REPO_METRIC_WEB=waypoint-metric-web
REPO_LYNX_HUB=lynx-hub
REPO_LYNX_CLOUD=lynx-cloud
REPO_ROZA=roza
REPO_ROZA_WEB=roza-web

DEPLOY_ROOT=/opt/waypoint
BRANCH=main

# Секреты продакшена (сгенерируйте openssl rand -hex 32)
JWT_SECRET=change-me-min-32-chars-production-secret
