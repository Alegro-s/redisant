# Скопируйте рядом со скриптами или экспортируйте перед запуском:
#   set -a && source paths.env && set +a
#
# Корень клона NEXUS (где лежит docker-compose.yml):
# NEXUS_ROOT=/root/nexus
#
# Профиль ТулГУ (рядом с NEXUS на том же VPS):
# TSPUT_ROOT=/root/tsput_profile

NEXUS_ROOT="${NEXUS_ROOT:-$HOME/nexus}"
TSPUT_ROOT="${TSPUT_ROOT:-$HOME/tsput_profile}"
