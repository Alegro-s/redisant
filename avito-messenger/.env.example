# YALGSI (AVITO hackathon) — локальный пример
# На VPS используйте: /opt/waypoint/avito.env (см. deploy/ecosystem/avito.env.example)

POSTGRES_USER=aishield
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aishield

API_PORT=8000
PUBLIC_HOST=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:8000

ADMIN_API_KEY=generate-long-random-key
SECURE_CONFIG_SEED=generate-long-random-seed

MATTERMOST_URL=http://localhost:8065
MM_DB_PASSWORD=change_mm_password
MATTERMOST_SITEURL=http://localhost:8065

DEBUG=false
TELEGRAM_ALERTS_ENABLED=false
