<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RozaCompanion.Views.WaypointMark"
             Width="24"
             Height="24">
  <Viewbox Stretch="Uniform">
    <Canvas Width="24" Height="24">
      <Border Canvas.Left="3" Canvas.Top="14" Width="3.8" Height="7" CornerRadius="1"
              Background="{DynamicResource AccentUi}" Opacity="0.72" />
      <Border Canvas.Left="8.2" Canvas.Top="11" Width="3.8" Height="10" CornerRadius="1"
              Background="{DynamicResource AccentUi}" Opacity="0.9" />
      <Border Canvas.Left="13.4" Canvas.Top="7.5" Width="3.8" Height="13.5" CornerRadius="1"
              Background="{DynamicResource AccentUiHover}" />
      <Path Data="M 17.2 16.2 Q 19.6 12.8 21.4 7.2"
            Stroke="{DynamicResource AccentUi}"
            StrokeThickness="1.35"
            StrokeLineCap="Round"
            Fill="Transparent" />
      <Ellipse Canvas.Left="19.55" Canvas.Top="5.05" Width="3.7" Height="3.7"
               Fill="{DynamicResource Card}"
               Stroke="{DynamicResource AccentUiHover}"
               StrokeThickness="1.1" />
      <Ellipse Canvas.Left="20.75" Canvas.Top="6.25" Width="1.3" Height="1.3"
               Fill="{DynamicResource AccentUiHover}" />
    </Canvas>
  </Viewbox>
</UserControl>
