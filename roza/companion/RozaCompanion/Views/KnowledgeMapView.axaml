<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RozaCompanion.Views.KnowledgeMapView">
  <DockPanel LastChildFill="True">
    <TextBlock DockPanel.Dock="Top"
               Text="Статическая схема (не данные с вашего ПК)."
               FontSize="10"
               Foreground="{DynamicResource TextMuted}"
               Margin="0,0,0,8"
               TextWrapping="Wrap" />
    <Border CornerRadius="16"
            Padding="12"
            BorderBrush="{DynamicResource MapNodeBorder}"
            BorderThickness="1"
            ClipToBounds="True"
            Background="{DynamicResource Card}">
      <Viewbox Stretch="Uniform" MaxHeight="220" HorizontalAlignment="Center">
        <Canvas Width="320" Height="300">
          <Path Stroke="{DynamicResource MapLine}" StrokeThickness="2" Opacity="0.45"
                Data="M 66 58 C 95 78, 118 95, 136 118" />
          <Path Stroke="{DynamicResource MapLine}" StrokeThickness="2" Opacity="0.45"
                Data="M 198 58 C 172 82, 155 98, 160 118" />
          <Path Stroke="{DynamicResource MapLine}" StrokeThickness="2" Opacity="0.45"
                Data="M 160 162 C 158 182, 155 198, 78 222" />
          <Path Stroke="{DynamicResource MapLine}" StrokeThickness="2" Opacity="0.45"
                Data="M 198 162 C 222 188, 238 208, 258 226" />

          <Border Canvas.Left="10" Canvas.Top="28" Width="96" Height="44" CornerRadius="14"
                  Background="{DynamicResource MapNode}" BorderBrush="{DynamicResource MapNodeBorder}" BorderThickness="1"
                  BoxShadow="0 1 4 0 #18000000">
            <TextBlock Text="Вы" FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" />
          </Border>
          <Border Canvas.Left="168" Canvas.Top="20" Width="104" Height="44" CornerRadius="14"
                  Background="{DynamicResource MapNode}" BorderBrush="{DynamicResource MapNodeBorder}" BorderThickness="1"
                  BoxShadow="0 1 4 0 #18000000">
            <TextBlock Text="Сессия" FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" />
          </Border>
          <Border Canvas.Left="108" Canvas.Top="118" Width="124" Height="52" CornerRadius="16"
                  Background="{DynamicResource MapNode}" BorderBrush="{DynamicResource MapNodeBorder}" BorderThickness="1"
                  BoxShadow="0 1 4 0 #18000000">
            <TextBlock Text="Сервер" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" />
          </Border>
          <Border Canvas.Left="218" Canvas.Top="118" Width="92" Height="44" CornerRadius="14"
                  Background="{DynamicResource MapNode}" BorderBrush="{DynamicResource MapNodeBorder}" BorderThickness="1"
                  BoxShadow="0 1 4 0 #18000000">
            <TextBlock Text="LLM" FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" />
          </Border>
          <Border Canvas.Left="14" Canvas.Top="212" Width="112" Height="44" CornerRadius="14"
                  Background="{DynamicResource MapNode}" BorderBrush="{DynamicResource MapNodeBorder}" BorderThickness="1"
                  BoxShadow="0 1 4 0 #18000000">
            <TextBlock Text="Workspace" FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" TextAlignment="Center" />
          </Border>
          <Border Canvas.Left="188" Canvas.Top="212" Width="118" Height="44" CornerRadius="14"
                  Background="{DynamicResource MapNode}" BorderBrush="{DynamicResource MapNodeBorder}" BorderThickness="1"
                  BoxShadow="0 1 4 0 #18000000">
            <TextBlock Text="Инструменты" FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" />
          </Border>
        </Canvas>
      </Viewbox>
    </Border>
  </DockPanel>
</UserControl>
