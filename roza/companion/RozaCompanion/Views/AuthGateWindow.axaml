<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RozaCompanion.ViewModels"
        x:Class="RozaCompanion.Views.AuthGateWindow"
        x:DataType="vm:AuthGateViewModel"
        Icon="/Assets/roza-icon.png"
        Title="Roza AI"
        Width="480" Height="580"
        MinWidth="440" MinHeight="540"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA"
        FontFamily="Segoe UI Variable, Segoe UI, Roboto">

    <Window.Styles>
        <Style Selector="TextBox.RzField">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#202124" />
            <Setter Property="CaretBrush" Value="#202124" />
            <Setter Property="BorderBrush" Value="#DADCE0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBox.RzField:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style Selector="TextBox.RzField:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.RzPrimary">
            <Setter Property="Background" Value="#1A73E8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.RzGhost">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1A73E8" />
            <Setter Property="BorderBrush" Value="#DADCE0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Panel>
        <Panel.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#F8F9FA" Offset="0" />
                <GradientStop Color="#E8F0FE" Offset="0.55" />
                <GradientStop Color="#F3E8FD" Offset="1" />
            </LinearGradientBrush>
        </Panel.Background>

        <Border MaxWidth="380"
                Margin="24"
                Padding="28,26"
                CornerRadius="20"
                Background="White"
                BorderBrush="#DADCE0"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <Border Width="72" Height="72" CornerRadius="16" Background="#000000" ClipToBounds="True">
                        <Image Source="/Assets/roza-icon.png" Stretch="Uniform" Margin="10" />
                    </Border>
                    <TextBlock Text="Roza AI" FontSize="22" FontWeight="SemiBold" Foreground="#202124" HorizontalAlignment="Center" />
                    <TextBlock Text="Консультант" FontSize="12" Foreground="#5F6368" HorizontalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding StatusHint}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="13"
                           Foreground="#5F6368"
                           LineHeight="18" />

                <TextBox Classes="RzField"
                         PlaceholderText="Email или логин"
                         Text="{Binding Login}" />
                <TextBox Classes="RzField"
                         PlaceholderText="Пароль"
                         Text="{Binding Password}"
                         PasswordChar="•" />

                <TextBlock Text="{Binding ErrorText}"
                           Foreground="#D93025"
                           TextWrapping="Wrap"
                           FontSize="12" />

                <Button Classes="RzPrimary"
                        Content="Войти"
                        Command="{Binding SignInCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        HorizontalAlignment="Stretch" />

                <Button Classes="RzGhost"
                        Content="Создать аккаунт на сайте"
                        Command="{Binding OpenRegisterInBrowserCommand}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>
    </Panel>
</Window>
