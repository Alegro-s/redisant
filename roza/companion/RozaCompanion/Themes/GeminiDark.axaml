<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Roza AI — тёмная: нативный клиент; LizaAccent — облачный режим (подпись в UI) -->
  <SolidColorBrush x:Key="RzBg" Color="#050608" />
  <SolidColorBrush x:Key="RzPanel" Color="#0A0D12" />
  <SolidColorBrush x:Key="RzMainSurface" Color="#0E1118" />
  <SolidColorBrush x:Key="RzElevated" Color="#141A24" />
  <SolidColorBrush x:Key="RzBorder" Color="#243044" />
  <SolidColorBrush x:Key="RzHover" Color="#1A2332" />
  <SolidColorBrush x:Key="RzNavSel" Color="#1C2438" />
  <SolidColorBrush x:Key="RzText" Color="#F4F6FB" />
  <SolidColorBrush x:Key="RzMuted" Color="#8FA3BF" />
  <SolidColorBrush x:Key="RzBlue" Color="#5B8DEF" />
  <SolidColorBrush x:Key="Card" Color="#121820" />
  <SolidColorBrush x:Key="TextPrimary" Color="#F4F6FB" />
  <SolidColorBrush x:Key="TextMuted" Color="#8FA3BF" />
  <SolidColorBrush x:Key="FillSoft" Color="#151C28" />
  <SolidColorBrush x:Key="Hairline" Color="#2A3A52" />
  <SolidColorBrush x:Key="AccentUi" Color="#D12D5A" />
  <SolidColorBrush x:Key="AccentUiHover" Color="#E8477A" />
  <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="OverlayScrim" Color="#CC000000" />
  <SolidColorBrush x:Key="RozaSurfaceBrush" Color="#050608" />
  <SolidColorBrush x:Key="RozaAccentBrush" Color="#D12D5A" />
  <SolidColorBrush x:Key="RozaAccentHoverBrush" Color="#E8477A" />
  <SolidColorBrush x:Key="RozaNavSelectedBrush" Color="#2A1520" />
  <SolidColorBrush x:Key="LizaAccent" Color="#12B5CB" />
  <SolidColorBrush x:Key="WaypointGreen" Color="#12B5CB" />
  <SolidColorBrush x:Key="WaypointBlue" Color="#5B8DEF" />
  <SolidColorBrush x:Key="MapLine" Color="#3D5268" />
  <SolidColorBrush x:Key="MapNode" Color="#141A24" />
  <SolidColorBrush x:Key="MapNodeBorder" Color="#2A3A52" />
  <SolidColorBrush x:Key="ChatWell" Color="#0A0D12" />
  <SolidColorBrush x:Key="GeminiChipBg" Color="#151C28" />
  <SolidColorBrush x:Key="GeminiChipBorder" Color="#2A3A52" />
  <SolidColorBrush x:Key="GradBlue" Color="#5B8DEF" />
  <SolidColorBrush x:Key="GradPurple" Color="#9B6DFF" />
  <SolidColorBrush x:Key="GradCoral" Color="#D12D5A" />
</ResourceDictionary>
