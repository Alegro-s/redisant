<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RozaCompanion.App"
             xmlns:local="using:RozaCompanion"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="RozaAccentBrush" Color="#D12D5A" />
        <SolidColorBrush x:Key="RozaAccentHoverBrush" Color="#E8477A" />
        <SolidColorBrush x:Key="LizaAccentBrush" Color="#12B5CB" />
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        </Style>
    </Application.Styles>
</Application>
